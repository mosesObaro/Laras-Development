# Resend API Delivery Configuration (Recommended)
# Obtain free API key from https://resend.com
RESEND_API_KEY=re_123456789abcdef
RESEND_FROM_EMAIL=Pre-University System <onboarding@resend.dev>

# Fallback SMTP Delivery Configuration (Optional)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=onboarding@resend.dev

# Calendar & Daily Alert Configuration
START_DATE=2026-09-01
DAILY_ALERT_ENABLED=true
MAX_LEARN_NOW_RECOMMENDATIONS=2
MAX_LONG_TERM_RECOMMENDATIONS=1
MIN_DAILY_ALERT_RELEVANCE_SCORE=70
LOOKBACK_DAYS_FOR_NEW_OPPS=14

# Scoring & Alert Thresholds
ALERT_SCORE_THRESHOLD=85
CONSIDER_SCORE_THRESHOLD=70
