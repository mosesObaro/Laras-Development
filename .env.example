# Student Profile
STUDENT_NAME=Lara
STUDENT_EMAIL=lara@example.com
PARENT_EMAIL=parent@example.com
COUNTRY=Nigeria
STATE=Edo
CITY=Benin City
UNIVERSITY=University of Benin (UNIBEN)
TARGET_FIELD=Healthcare / Medical Sciences
