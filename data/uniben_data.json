  "first_30_days_action_checklist": [
    { "step": 1, "day_range": "Day 1 - 3", "action": "Accept Admission on JAMB CAPS & Pay UNIBEN Acceptance Fee via Kofa/WAeUP Portal", "critical": true },
    { "step": 2, "day_range": "Day 4 - 7", "action": "Gather 15 Red-Background Passport Photos, Original WAEC Certificate/Statement of Result, Birth Certificate, LGA Identification Letter", "critical": true },
    { "step": 3, "day_range": "Day 8 - 10", "action": "Complete Online Clearance & Verification on UNIBEN WAeUP Portal", "critical": true },
    { "step": 4, "day_range": "Day 11 - 14", "action": "Pay University School Charges / Tuition via Remita and Print Receipt", "critical": true },
    { "step": 5, "day_range": "Day 15 - 18", "action": "Physical Clearance at Main Auditorium / Faculty Clearance Desk with File Jacket", "critical": true },
    { "step": 6, "day_range": "Day 19 - 21", "action": "Complete Course Registration for 100-Level First Semester and submit Course Forms to Course Adviser for signature", "critical": true },
    { "step": 7, "day_range": "Day 22 - 24", "action": "Undergo Medical Screening & Chest X-Ray at UNIBEN Health Centre (Ugbowo Campus)", "critical": true },
    { "step": 8, "day_range": "Day 25 - 26", "action": "Register for John Harris Library Card and Attend Library Orientation", "critical": false },
    { "step": 9, "day_range": "Day 27 - 28", "action": "Finalize Accommodation (Hall of Residence clearance or verified off-campus BDPA/Ekosodin leasing with guardian)", "critical": true },
    { "step": 10, "day_range": "Day 29 - 30", "action": "Attend Faculty & Departmental Matriculation Orientation and Connect with Departmental Course Representatives", "critical": false }
